@startuml Hexagonal_Architecture
!theme plain
title Tech Challenge - Sistema de Gestão de Usuários e Endereços - Arquitetura Hexagonal

' Configuração de cores e estilos
skinparam package {
    BackgroundColor<<core>> #E1F5FE
    BorderColor<<core>> #0277BD
    BackgroundColor<<adapter>> #F3E5F5
    BorderColor<<adapter>> #7B1FA2
    BackgroundColor<<infrastructure>> #E8F5E8
    BorderColor<<infrastructure>> #2E7D32
}

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #424242
    FontSize 12
}

skinparam interface {
    BackgroundColor #FFF59D
    BorderColor #F57F17
}

' Atores externos
actor "Cliente/Postman" as Client #FFE0B2
database "PostgreSQL\nDatabase" as DB #C8E6C9

' Camada de Infraestrutura - Adaptadores de Entrada (Driving Adapters)
package "Driving Adapters" <<adapter>> {
    component "UserController" as UserController
    component "AddressController" as AddressController
    component "LoginController" as LoginController
    component "JwtAuthenticationFilter" as JwtFilter
    component "GlobalExceptionHandler" as ExceptionHandler
    
    note right of UserController
        • POST /api/v1/users (CLIENT)
        • POST /api/v1/users/owner (ADMIN)
        • GET /api/v1/users/{id}
        • GET /api/v1/users/by-name
        • PUT /api/v1/users/{id}
        • PATCH /api/v1/users/password
        • DELETE /api/v1/users/{id}
    end note
    
    note right of AddressController
        • GET /api/v1/address (list user addresses)
        • POST /api/v1/address (create address)
        • PUT /api/v1/address/{addressId} (update address)
        • DELETE /api/v1/address/{addressId} (delete address)
        • Ownership validation in all operations
    end note
    
    note right of LoginController
        • POST /api/v1/auth/login
    end note
    
    note right of JwtFilter
        • JWT Token Validation
        • Security Context Setup
        • Authentication Principal
    end note
}

' Núcleo da Aplicação (Core)
package "Application Core" <<core>> {
    
    ' Portas de Entrada (Primary Ports) - User
    package "User Primary Ports" {
        interface "UserCreatePort" as IUserCreate
        interface "UserCreateOwnerPort" as IUserCreateOwner
        interface "UserUpdatePort" as IUserUpdate
        interface "UserUpdatePasswordPort" as IUserUpdatePassword
        interface "UserFindByIdPort" as IUserFindById
        interface "UserFindByNamePort" as IUserFindByName
        interface "UserDeletePort" as IUserDelete
        interface "AuthPort" as IAuth
    }
    
    ' Portas de Entrada (Primary Ports) - Address
    package "Address Primary Ports" {
        interface "AddressCreatePort" as IAddressCreate
        interface "AddressFindByUserPort" as IAddressFindByUser
        interface "AddressUpdatePort" as IAddressUpdate
        interface "AddressDeletePort" as IAddressDelete
    }
    
    ' Casos de Uso (Use Cases) - User
    package "User Use Cases" {
        component "CreateUserUseCase" as CreateUserUC
        component "CreateOwnerUseCase" as CreateOwnerUC
        component "UpdateUserUseCase" as UpdateUserUC
        component "UpdatePasswordUseCase" as UpdatePasswordUC
        component "FindUserByIdUseCase" as FindByIdUC
        component "FindUserByNameUseCase" as FindByNameUC
        component "DeleteUserUseCase" as DeleteUserUC
        component "AuthUseCase" as AuthUC
    }
    
    ' Casos de Uso (Use Cases) - Address
    package "Address Use Cases" {
        component "CreateAddressUseCase" as CreateAddressUC
        component "FindAddressUseCase" as FindAddressUC
        component "UpdateAddressUseCase" as UpdateAddressUC
        component "DeleteAddressUseCase" as DeleteAddressUC
    }
    
    ' Domínio (Domain Models)
    package "Domain Models" {
        component "UserDomain" as UserEntity
        component "AddressDomain" as AddressEntity
        component "RolesEnum" as RolesEnum
        component "Email (Value Object)" as EmailVO
        component "Username (Value Object)" as UsernameVO
        component "PersonName (Value Object)" as PersonNameVO
        component "UserDomainService" as UserDomainService
        component "AddressDomainService" as AddressDomainService
    }
    
    ' Portas de Saída (Secondary Ports)
    package "Secondary Ports" {
        interface "UserRepositoryPort" as IUserRepo
        interface "AddressRepositoryPort" as IAddressRepo
        interface "PasswordEncoderPort" as IPasswordEncoder
        interface "TokenGeneratorPort" as ITokenGenerator
    }
}

' Camada de Infraestrutura - Adaptadores de Saída (Driven Adapters)
package "Driven Adapters" <<infrastructure>> {
    component "UserRepositoryImpl" as UserRepoAdapter
    component "AddressRepositoryImpl" as AddressRepoAdapter
    component "JpaUserRepository" as JpaUserRepo
    component "JpaAddressRepository" as JpaAddressRepo
    component "BCryptPasswordEncoderAdapter" as PasswordEncoder
    component "JwtUtil" as TokenGenerator
    component "UserEntityMapper" as UserMapper
    component "AddressEntityMapper" as AddressMapper
    component "JpaUserEntity" as JpaUserEntity
    component "JpaAddressEntity" as JpaAddressEntity
    
    note right of UserRepoAdapter
        • JPA Repository Implementation
        • Entity Mapping
        • Query Implementation
        • UserDomain ↔ JpaUserEntity
    end note
    
    note right of AddressRepoAdapter
        • Address CRUD operations
        • AddressDomain ↔ JpaAddressEntity
        • User relationship handling
    end note
}

' Relacionamentos - Entrada
Client --> UserController : HTTP Requests\n(JSON)
Client --> AddressController : Address Requests\n(JSON)
Client --> LoginController : Authentication\nRequests

UserController --> IUserCreate : Uses
UserController --> IUserCreateOwner : Uses
UserController --> IUserUpdate : Uses
UserController --> IUserUpdatePassword : Uses
UserController --> IUserFindById : Uses
UserController --> IUserFindByName : Uses
UserController --> IUserDelete : Uses

AddressController --> IAddressCreate : Uses
AddressController --> IAddressFindByUser : Uses
AddressController --> IAddressUpdate : Uses
AddressController --> IAddressDelete : Uses

LoginController --> IAuth : Uses

' Relacionamentos - Use Cases implementam Ports
IUserCreate --> CreateUserUC : Implements
IUserCreateOwner --> CreateOwnerUC : Implements
IUserUpdate --> UpdateUserUC : Implements
IUserUpdatePassword --> UpdatePasswordUC : Implements
IUserFindById --> FindByIdUC : Implements
IUserFindByName --> FindByNameUC : Implements
IUserDelete --> DeleteUserUC : Implements
IAuth --> AuthUC : Implements

IAddressCreate --> CreateAddressUC : Implements
IAddressFindByUser --> FindAddressUC : Implements
IAddressUpdate --> UpdateAddressUC : Implements
IAddressDelete --> DeleteAddressUC : Implements

' Relacionamentos - Domain
CreateUserUC --> UserEntity : Creates
CreateUserUC --> AddressEntity : Creates (with user)
UpdateUserUC --> UserEntity : Updates
FindByIdUC --> UserEntity : Returns
FindByNameUC --> UserEntity : Returns
AuthUC --> UserEntity : Validates

CreateAddressUC --> AddressEntity : Creates
UpdateAddressUC --> AddressEntity : Updates
FindAddressUC --> AddressEntity : Returns
DeleteAddressUC --> AddressEntity : Deletes

UserEntity --> EmailVO : Contains
UserEntity --> UsernameVO : Contains
UserEntity --> PersonNameVO : Contains
UserEntity --> RolesEnum : Has

AddressEntity --> UserEntity : Belongs to

' Domain Services
UserDomainService --> UserEntity : Validates
AddressDomainService --> AddressEntity : Validates

' Relacionamentos - Use Cases para Ports de Saída
CreateUserUC --> IUserRepo : Uses
CreateUserUC --> IAddressRepo : Uses (for address)
UpdateUserUC --> IUserRepo : Uses
FindByIdUC --> IUserRepo : Uses
FindByNameUC --> IUserRepo : Uses
DeleteUserUC --> IUserRepo : Uses
UpdatePasswordUC --> IPasswordEncoder : Uses
AuthUC --> IPasswordEncoder : Uses
AuthUC --> ITokenGenerator : Uses

CreateAddressUC --> IAddressRepo : Uses
FindAddressUC --> IAddressRepo : Uses
UpdateAddressUC --> IAddressRepo : Uses
DeleteAddressUC --> IAddressRepo : Uses

' Relacionamentos - Saída
IUserRepo --> UserRepoAdapter : Implements
IAddressRepo --> AddressRepoAdapter : Implements
IPasswordEncoder --> PasswordEncoder : Implements
ITokenGenerator --> TokenGenerator : Implements

UserRepoAdapter --> JpaUserRepo : Uses
UserRepoAdapter --> UserMapper : Uses
UserRepoAdapter --> JpaUserEntity : Maps to/from

AddressRepoAdapter --> JpaAddressRepo : Uses
AddressRepoAdapter --> AddressMapper : Uses
AddressRepoAdapter --> JpaAddressEntity : Maps to/from

JpaUserRepo --> DB : Persists
JpaAddressRepo --> DB : Persists
JpaAddressEntity --> JpaUserEntity : References (FK)

' Tratamento de exceções
UserController --> ExceptionHandler : handles errors
AddressController --> ExceptionHandler : handles errors
LoginController --> ExceptionHandler : handles errors

@enduml