		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Extract token and save to collection variable\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('accessToken');",
							"    pm.collectionVariables.set('token', jsonData.accessToken);",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"login\": \"joao.silva7\",\r\n    \"password\": \"senha123\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{host}}/api/v1/auth/login",
					"host": [
						"{{host}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				},
				"description": "Generated from cURL: curl -X POST http://localhost:8080/login -H \"Content-Type: application/json\" -d '{\"login\": \"vpadovam\", \"password\": \"senha123\"}' -s"
			},
			"response": []
		},
		{
			"name": "Criar Usuário (CLIENT)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Captura o campo 'id' da resposta e armazena na variável de coleção 'user_id'",
							"if (pm.response.code === 201) {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData && jsonData.id) {",
							"        pm.collectionVariables.set('user_id', jsonData.id);",
							"        pm.test('O campo id foi salvo na variável de coleção user_id', function () {",
							"            pm.expect(pm.collectionVariables.get('user_id')).to.eql(jsonData.id);",
							"        });",
							"    } else {",
							"        pm.test('Resposta não contém o campo id', function () {",
							"            pm.expect(jsonData && jsonData.id).to.not.be.undefined;",
							"        });",
							"    }",
							"} else {",
							"    pm.test('Código de resposta não é 201', function () {",
							"        pm.expect(pm.response.code).to.eql(201);",
							"    });",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
