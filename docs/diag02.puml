@startuml Domain_Model_Classes
!theme plain
title Modelo de Domínio - Sistema de Gestão de Usuários

' Configuração de estilos
skinparam class {
    BackgroundColor<<entity>> #E3F2FD
    BorderColor<<entity>> #1976D2
    BackgroundColor<<value_object>> #F3E5F5
    BorderColor<<value_object>> #7B1FA2
    BackgroundColor<<enum>> #FFF3E0
    BorderColor<<enum>> #F57C00
    BackgroundColor<<service>> #E8F5E8
    BorderColor<<service>> #388E3C
    BackgroundColor<<port>> #FFECB3
    BorderColor<<port>> #FF8F00
}

skinparam classAttributeIconVisible false

' Entidade Principal do Domínio
package "Domain Entities" {
    
    class UserDomain <<entity>> {
        - id: UUID
        - name: PersonName
        - email: Email
        - login: Username
        - password: String
        - createdAt: LocalDateTime
        - updatedAt: LocalDateTime
        - role: List<RolesEnum>
        - isActive: boolean
        --
        ' Factory Methods
        + createClient(name, email, login, password): UserDomain
        + createOwner(name, email, login, password): UserDomain
        --
        ' Business Methods
        + updateInfo(name, email, login): void
        + changePassword(newPassword): void
        + deactivate(): void
        + activate(): void
        + hasRole(role): boolean
        + isClient(): boolean
        + isOwner(): boolean
        + isActive(): boolean
        --
        ' Convenience getters
        + getName(): String
        + getEmail(): String
        + getLogin(): String
        + getIdAsString(): String
        --
        ' Value Object getters
        + getPersonName(): PersonName
        + getEmailObject(): Email
        + getUsernameObject(): Username
        --
        # validatePassword(password): void
    }
}

' Enumerações
package "Domain Enums" {
    
    enum RolesEnum <<enum>> {
        ADMIN
        OWNER
        CLIENT
        --
        + toString(): String
    }
}

' Value Objects
package "Value Objects" {
    
    class Email <<value_object>> {
        - value: String
        --
        + of(email: String): Email
        + getValue(): String
        + equals(obj: Object): boolean
        + hashCode(): int
        + toString(): String
        --
        # validate(email: String): void
        # normalize(email: String): String
        --
        ' Constantes
        {static} MAX_LENGTH: int = 255
        {static} EMAIL_PATTERN: String
    }
    
    class Username <<value_object>> {
        - value: String
        --
        + of(username: String): Username
        + getValue(): String
        + equals(obj: Object): boolean
        + hashCode(): int
        + toString(): String
        --
        # validate(username: String): void
        # normalize(username: String): String
        --
        ' Constantes
        {static} MIN_LENGTH: int = 3
        {static} MAX_LENGTH: int = 50
        {static} VALID_PATTERN: String
    }
    
    class PersonName <<value_object>> {
        - value: String
        --
        + of(name: String): PersonName
        + getValue(): String
        + getFirstName(): String
        + getLastName(): String
        + equals(obj: Object): boolean
        + hashCode(): int
        + toString(): String
        --
        # validate(name: String): void
        # normalize(name: String): String
        --
        ' Constantes
        {static} MIN_LENGTH: int = 2
        {static} MAX_LENGTH: int = 255
    }
}

' Domain Services
package "Domain Services" {
    
    class UserDomainService <<service>> {
        --
        + validateUserBusinessRules(user: UserDomain): void
        + canUpdateUser(currentUser: UserDomain, targetUser: UserDomain): boolean
        + canDeleteUser(currentUser: UserDomain, targetUser: UserDomain): boolean
        + generateUsername(email: String): Username
        + isEmailUnique(email: Email, userId: UUID): boolean
        + isUsernameUnique(username: Username, userId: UUID): boolean
        --
        # validateRole(role: RolesEnum): void
        # validateUserState(user: UserDomain): void
    }
}

' Domain Exceptions
package "Domain Exceptions" {
    
    class BusinessRuleException <<entity>> {
        - message: String
        --
        + BusinessRuleException(message: String)
        + getMessage(): String
    }
    
    class InvalidFieldException <<entity>> {
        - fieldName: String
        - message: String
        --
        + InvalidFieldException(fieldName: String, message: String)
        + getFieldName(): String
        + getMessage(): String
    }
}

' Ports (Interfaces)
package "Domain Ports" {
    
    interface UserRepositoryPort <<port>> {
        + findById(id: UUID): Optional<UserDomain>
        + findByEmail(email: Email): Optional<UserDomain>
        + findByUsername(username: Username): Optional<UserDomain>
        + findByName(name: String): List<UserDomain>
        + save(user: UserDomain): UserDomain
        + delete(id: UUID): void
        + existsByEmail(email: Email): boolean
        + existsByUsername(username: Username): boolean
    }
    
    interface PasswordEncoderPort <<port>> {
        + encode(rawPassword: String): String
        + matches(rawPassword: String, encodedPassword: String): boolean
    }
    
    interface TokenGeneratorPort <<port>> {
        + generateToken(userDomain: UserDomain): String
        + validateToken(token: String): boolean
        + getUsernameFromToken(token: String): String
    }
}

' Relacionamentos
UserDomain --> PersonName : contains
UserDomain --> Email : contains  
UserDomain --> Username : contains
UserDomain --> RolesEnum : has

Email ..> InvalidFieldException : throws
Username ..> InvalidFieldException : throws
PersonName ..> InvalidFieldException : throws
UserDomain ..> BusinessRuleException : throws

UserDomainService --> UserDomain : validates
UserDomainService --> UserRepositoryPort : uses

note top of UserDomain
    **Entidade Rica de Domínio**
    - Encapsula regras de negócio
    - Factory methods para criação
    - Valida invariantes
    - Usa Value Objects
    - Imutabilidade onde possível
end note

note top of Email
    **Value Object**
    - Imutável
    - Auto-validável  
    - Comparável por valor
    - Regras de domínio encapsuladas
end note

note bottom of RolesEnum
    **ADMIN**: Acesso total
    **OWNER**: Proprietário
    **CLIENT**: Cliente comum
end note

@enduml