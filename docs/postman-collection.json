						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"currentPassword\": \"senhaSegura456\",\r\n  \"newPassword\": \"senha123\",\r\n  \"confirmPassword\":\"senha123\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{host}}/api/v1/users/password",
					"host": [
						"{{host}}"
					],
					"path": [
						"api",
						"v1",
						"users",
						"password"
					]
				},
				"description": "Atualização da própria senha do usuário autenticado.\nRota: PATCH /api/v1/users/password\nSegurança: ADMIN, OWNER ou CLIENT (próprio usuário)"
			},
			"response": []
		},
		{
			"name": "Atualizar Dados do Usuário",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\": \"Nome Atualizado\",\r\n    \"email\": \"email.atualizado@exemplo.com\",\r\n    \"login\": \"login.atualizado\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{host}}/api/v1/users/{{user_id}}",
					"host": [
						"{{host}}"
					],
					"path": [
						"api",
						"v1",
						"users",
						"{{user_id}}"
					]
				},
				"description": "Atualização dos dados do usuário.\nRota: PUT /api/v1/users/{id}\nSegurança: ADMIN, OWNER ou CLIENT (próprio usuário)"
			},
			"response": []
		},
		{
			"name": "Buscar Usuário por ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
