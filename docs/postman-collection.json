					]
				},
				"description": "Busca usuários por nome.\nRota: GET /api/v1/users/by-name?name={nome}\nSegurança: ADMIN ou OWNER"
			},
			"response": []
		},
		{
			"name": "Deletar Usuário",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{host}}/api/v1/users/{{user_id}}",
					"host": [
						"{{host}}"
					],
					"path": [
						"api",
